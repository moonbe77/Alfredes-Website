---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Cabaña Alfredes">
	<div>
		<!-- Full-page Video Hero Section -->
		<div class="relative h-screen w-full overflow-hidden">
			<!-- Video Background (source added via JS) -->
			<video
				id="hero-video"
				muted
				loop
				playsinline
				poster="/assets/hero_xl.jpg"
				preload="none"
				class="absolute inset-0 w-full h-full object-cover"
				data-src="/assets/hero-video.webm"
			>
			</video>

			<!-- Dark overlay -->

			<div
				id="hero-overlay"
				class="absolute inset-0 bg-linear-to-r from-black/70 via-black/50 to-black/30 transition-opacity duration-500"
			>
				<!-- Hero Content - Left aligned like Beyonk -->
				<div
					id="hero-content"
					class="relative z-10 container mx-auto px-6 md:px-12 min-h-screen flex items-center transition-opacity duration-500"
				>
					<div class="max-w-2xl text-white">
						<h1
							class="text-5xl md:text-6xl lg:text-7xl font-bold italic mb-6 text-shadow-lg tracking-tight leading-tight"
						>
							Cabaña Alfredes.
						</h1>
						<p
							class="text-lg md:text-xl font-light mb-10 text-white/85 text-shadow-sm"
						>
							Tu refugio en el Delta del Paraná. Naturaleza, río y tranquilidad.
						</p>

						<div class="flex flex-wrap items-center gap-4">
							<a
								href="/contacto"
								class="px-8 py-3.5 bg-emerald-800 hover:bg-emerald-600 text-white font-semibold rounded-lg transition-colors text-lg"
							>
								Reservá tu estadía
							</a>
						</div>
					</div>
				</div>
			</div>
			<button
				id="video-toggle"
				class="video-toggle-btn absolute top-20 right-6 z-40 w-12 h-12 rounded-full bg-black/40 backdrop-blur-sm border border-white/20 text-white flex items-center justify-center cursor-pointer transition-all duration-300 hover:bg-black/60 hover:scale-110 hover:border-white/40"
				aria-label="Play video"
			>
				<svg
					id="icon-play"
					class="w-5 h-5 ml-0.5"
					fill="currentColor"
					viewBox="0 0 24 24"
				>
					<path d="M8 5v14l11-7z"></path>
				</svg>
				<svg
					id="icon-pause"
					class="w-5 h-5 hidden"
					fill="currentColor"
					viewBox="0 0 24 24"
				>
					<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
				</svg>
			</button>
		</div>

		<script>
			const video = document.getElementById("hero-video") as HTMLVideoElement;
			const toggleBtn = document.getElementById("video-toggle")!;
			const iconPlay = document.getElementById("icon-play")!;
			const iconPause = document.getElementById("icon-pause")!;
			const heroContent = document.getElementById("hero-content")!;
			const heroOverlay = document.getElementById("hero-overlay")!;
			const videoSrc = video.dataset.src!;
			let videoLoaded = false;
			const media = window.matchMedia("(max-width: 767px)");

			function loadVideo(): Promise<void> {
				if (videoLoaded) return Promise.resolve();
				videoLoaded = true;
				video.src = videoSrc;
				video.load();
				return Promise.resolve();
			}

			function showPlayIcon() {
				iconPlay.classList.remove("hidden");
				iconPause.classList.add("hidden");
				toggleBtn.setAttribute("aria-label", "Play video");
			}

			function showPauseIcon() {
				iconPlay.classList.add("hidden");
				iconPause.classList.remove("hidden");
				toggleBtn.setAttribute("aria-label", "Pause video");
			}

			function hideHeroContent() {
				heroContent.style.opacity = "0";
				heroContent.style.pointerEvents = "none";
				heroOverlay.style.opacity = "0";
			}

			function showHeroContent() {
				heroContent.style.opacity = "1";
				heroContent.style.pointerEvents = "";
				heroOverlay.style.opacity = "1";
			}

			media.onchange = (e) => {
				if (e.matches) {
					/* the viewport is 600 pixels wide or less */
					console.log("This is a narrow screen — less than 600px wide.");
					video.pause();
				} else {
					/* the viewport is more than 600 pixels wide */
					console.log("This is a wide screen — more than 600px wide.");
					showHeroContent();
					loadVideo().then(() => {
						video.play().catch(() => {});
					});
				}
			};

			// Desktop: autoplay muted in background
			if (!media.matches) {
				loadVideo().then(() => {
					video.play().catch(() => {});
				});
			}

			// Toggle button: play or pause
			toggleBtn.addEventListener("click", () => {
				if (!video.paused) {
					video.pause();
					return;
				}
				if (media.matches) {
					hideHeroContent();
				}
				loadVideo().then(() => {
					video.muted = true;
					video.play().catch(() => {});
				});
			});

			video.addEventListener("playing", () => {
				showPauseIcon();
				if (media.matches) {
					hideHeroContent();
				}
			});

			video.addEventListener("pause", () => {
				showPlayIcon();
				if (media.matches) {
					showHeroContent();
				}
			});
		</script>

		<style>
			.text-shadow-lg {
				text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.7);
			}
			.text-shadow-md {
				text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.6);
			}
			.text-shadow-sm {
				text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
			}
		</style>
	</div>
</BaseLayout>
