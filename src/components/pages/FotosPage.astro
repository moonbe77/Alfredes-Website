---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { useTranslations } from '../../i18n/utils';

import foto_1 from '@/assets/gallery/exterior/foto_1.jpg';
import foto_2 from '@/assets/gallery/exterior/foto_2.jpg';
import foto_3 from '@/assets/gallery/exterior/foto_3.jpg';
import foto_4 from '@/assets/gallery/exterior/foto_4.jpg';
import foto_5 from '@/assets/gallery/exterior/foto_5.jpg';
import foto_6 from '@/assets/gallery/exterior/foto_6.jpg';
import foto_7 from '@/assets/gallery/exterior/foto_7.jpg';
import foto_8 from '@/assets/gallery/exterior/foto_8.jpg';
import foto_9 from '@/assets/gallery/exterior/foto_9.jpg';
import foto_10 from '@/assets/gallery/exterior/foto_10.jpg';
import photo_int_2 from '@/assets/gallery/interior/photo_int_2.jpg';
import photo_int_3 from '@/assets/gallery/interior/photo_int_3.jpg';
import photo_int_4 from '@/assets/gallery/interior/photo_int_4.jpg';
import photo_int_5 from '@/assets/gallery/interior/photo_int_5.jpg';
import photo_int_6 from '@/assets/gallery/interior/photo_int_6.jpg';
import photo_int_7 from '@/assets/gallery/interior/photo_int_7.jpg';
import photo_int_8 from '@/assets/gallery/interior/photo_int_8.jpg';
import photo_int_9 from '@/assets/gallery/interior/photo_int_9.jpg';

const t = useTranslations(Astro.currentLocale);

const exteriorImages = [
  { src: foto_1, alt: 'Vista aérea de la cabaña desde dron' },
  { src: foto_2, alt: 'Fachada frontal de la cabaña' },
  { src: foto_4, alt: 'Vista panorámica desde dron' },
  { src: foto_3, alt: 'Exterior completo de la cabaña' },
  { src: foto_5, alt: 'Vista lateral del exterior' },
  { src: foto_6, alt: 'Muelle y río desde la cabaña' },
  { src: foto_7, alt: 'Raposeras y vegetación del río' },
  { src: foto_8, alt: 'Detalle del exterior' },
  { src: foto_9, alt: 'Río y naturaleza circundante' },
  { src: foto_10, alt: 'Vista del río Parana' },
];

const interiorImages = [
  { src: photo_int_9, alt: 'Cama matrimonial con vista al río' },
  { src: photo_int_2, alt: 'Vista del río desde la habitación' },
  { src: photo_int_3, alt: 'Banco de madera en el interior' },
  { src: photo_int_5, alt: 'Escalera y salamandra de leña' },
  { src: photo_int_6, alt: 'Baño completo' },
  { src: photo_int_7, alt: 'Cocina equipada' },
  { src: photo_int_8, alt: 'Vista interior hacia el exterior' },
  { src: photo_int_4, alt: 'Amplia vista del exterior' },
];
---

<BaseLayout title={t('meta.fotos')}>
  <div class="min-h-screen bg-gradient-to-b from-emerald-50/50 via-white to-amber-50/30">
    <PageHero title={t('photos.pageTitle')} subtitle={t('photos.pageSubtitle')} />

    <div class="container mx-auto px-4 py-12">
      <!-- Tab Navigation -->
      <div class="flex justify-center mb-12">
        <div class="bg-white rounded-lg shadow-lg p-1 border">
          <div class="flex space-x-1">
            <button id="tab-interior" class="px-6 py-3 rounded-md font-medium transition-all duration-200 text-primary border-2 border-transparent hover:border-primary/20 active-tab">
              🏠 {t('photos.tabInterior')}
            </button>
            <button id="tab-exterior" class="px-6 py-3 rounded-md font-medium transition-all duration-200 text-muted-foreground hover:text-primary hover:bg-primary/5">
              🌿 {t('photos.tabExterior')}
            </button>
          </div>
        </div>
      </div>

      <!-- Interior Gallery -->
      <div id="gallery-interior" class="gallery-section">
        <div class="text-center mb-8">
          <h2 class="text-3xl font-bold text-primary mb-2">{t('photos.interiorTitle')}</h2>
          <p class="text-muted-foreground">{t('photos.interiorSubtitle')}</p>
        </div>
        <div class="columns-1 sm:columns-2 lg:columns-3 xl:columns-4 gap-4 space-y-4">
          {interiorImages.map((image) => (
            <div class="break-inside-avoid mb-4">
              <div class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 cursor-pointer transform hover:-translate-y-1">
                <Image src={image.src} alt={image.alt} class="w-full h-auto object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <div class="absolute bottom-0 left-0 right-0 p-4">
                    <p class="text-white text-sm font-medium">{image.alt}</p>
                  </div>
                </div>
                <div class="absolute top-4 right-4 w-8 h-8 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Exterior Gallery -->
      <div id="gallery-exterior" class="gallery-section hidden">
        <div class="text-center mb-8">
          <h2 class="text-3xl font-bold text-primary mb-2">{t('photos.exteriorTitle')}</h2>
          <p class="text-muted-foreground">{t('photos.exteriorSubtitle')}</p>
        </div>
        <div class="columns-1 sm:columns-2 lg:columns-3 xl:columns-4 gap-4 space-y-4">
          {exteriorImages.map((image) => (
            <div class="break-inside-avoid mb-4">
              <div class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 cursor-pointer transform hover:-translate-y-1">
                <Image src={image.src} alt={image.alt} class="w-full h-auto object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <div class="absolute bottom-0 left-0 right-0 p-4">
                    <p class="text-white text-sm font-medium">{image.alt}</p>
                  </div>
                </div>
                <div class="absolute top-4 right-4 w-8 h-8 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Lightbox Modal -->
      <div id="lightbox" class="fixed inset-0 bg-black/90 hidden z-50 flex items-center justify-center p-4">
        <div class="relative max-w-5xl max-h-full">
          <img id="lightbox-image" src="" alt="" class="max-w-full h-full max-h-[95vh] object-contain" />
          <button id="lightbox-close" class="absolute top-4 right-4 text-white text-2xl hover:text-gray-300 transition-colors">✕</button>
          <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-2xl hover:text-gray-300 transition-colors">‹</button>
          <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white text-2xl hover:text-gray-300 transition-colors">›</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    interface ImageData { src: string; alt: string; }

    const tabInterior = document.getElementById('tab-interior') as HTMLButtonElement;
    const tabExterior = document.getElementById('tab-exterior') as HTMLButtonElement;
    const galleryInterior = document.getElementById('gallery-interior') as HTMLDivElement;
    const galleryExterior = document.getElementById('gallery-exterior') as HTMLDivElement;

    function switchTab(activeTab: HTMLElement, activeGallery: HTMLElement, inactiveTab: HTMLElement, inactiveGallery: HTMLElement): void {
      activeTab.classList.add('active-tab');
      activeTab.classList.remove('text-muted-foreground', 'hover:bg-primary/5');
      activeTab.classList.add('text-primary', 'bg-primary/10');
      inactiveTab.classList.remove('active-tab', 'text-primary', 'bg-primary/10');
      inactiveTab.classList.add('text-muted-foreground', 'hover:bg-primary/5');
      activeGallery.classList.remove('hidden');
      inactiveGallery.classList.add('hidden');
    }

    tabInterior.addEventListener('click', () => switchTab(tabInterior, galleryInterior, tabExterior, galleryExterior));
    tabExterior.addEventListener('click', () => switchTab(tabExterior, galleryExterior, tabInterior, galleryInterior));

    const lightbox = document.getElementById('lightbox') as HTMLDivElement;
    const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
    const lightboxClose = document.getElementById('lightbox-close') as HTMLButtonElement;
    const lightboxPrev = document.getElementById('lightbox-prev') as HTMLButtonElement;
    const lightboxNext = document.getElementById('lightbox-next') as HTMLButtonElement;

    let currentImages: ImageData[] = [];
    let currentIndex = 0;

    document.querySelectorAll<HTMLDivElement>('.gallery-section .group').forEach((container) => {
      container.addEventListener('click', () => {
        const gallerySection = container.closest('.gallery-section') as HTMLElement;
        const allContainers = Array.from(gallerySection.querySelectorAll<HTMLDivElement>('.group'));
        currentImages = allContainers.map((c) => {
          const img = c.querySelector('img') as HTMLImageElement;
          return { src: img.src, alt: img.alt };
        });
        currentIndex = allContainers.indexOf(container);
        openLightbox(currentImages[currentIndex]);
      });
    });

    function openLightbox(imageData: ImageData) {
      lightboxImage.src = imageData.src;
      lightboxImage.alt = imageData.alt;
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }

    lightboxClose.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
    lightboxPrev.addEventListener('click', () => { currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length; openLightbox(currentImages[currentIndex]); });
    lightboxNext.addEventListener('click', () => { currentIndex = (currentIndex + 1) % currentImages.length; openLightbox(currentImages[currentIndex]); });

    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      else if (e.key === 'ArrowLeft') { currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length; openLightbox(currentImages[currentIndex]); }
      else if (e.key === 'ArrowRight') { currentIndex = (currentIndex + 1) % currentImages.length; openLightbox(currentImages[currentIndex]); }
    });

    switchTab(tabInterior, galleryInterior, tabExterior, galleryExterior);
  </script>
</BaseLayout>
